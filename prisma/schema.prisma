generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String?
  name          String?
  role          String   @default("student")
  avatarUrl     String?
  bio           String?
  school        String?
  year          String?
  streakCount   Int      @default(0)
  emailVerified DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts   Account[]
  sessions   Session[]
  studyLogs  StudyLog[]
  userSkills UserSkill[]
  goals      Goal[]
  projects   Project[]
  checkins         DailyCheckin[]
  pushSubscriptions PushSubscription[]
  resume           Resume?
  mentorConversations MentorConversation[]
  menteeProfile       MenteeProfile?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refreshToken      String?
  accessToken       String?
  expiresAt         Int?
  tokenType         String?
  scope             String?
  idToken           String?
  sessionState      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Skill {
  id          String  @id @default(cuid())
  name        String  @unique
  category    String?
  description String?
  createdAt   DateTime @default(now())

  userSkills    UserSkill[]
  studyLogSkills StudyLogSkill[]
}

model UserSkill {
  id             String   @id @default(cuid())
  userId         String
  skillId        String
  level          String   @default("beginner") // beginner | intermediate | expert
  xp             Int      @default(0)
  manualLogCount Int?
  updatedAt      DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
}

model StudyLog {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String?
  type      String   @default("text") // text | files | both
  aiSummary String?
  realWorldConnection String?
  nextStep   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  files        StudyLogFile[]
  skillTags    StudyLogSkill[]
  goalLinks    GoalStudyLog[]
  roadmapLinks StudyLogRoadmapItem[]

  @@index([userId, createdAt])
}

model StudyLogFile {
  id             String  @id @default(cuid())
  studyLogId     String
  fileUrl        String
  fileType       String
  fileName       String
  filePath       String?
  extractedText  String?

  studyLog StudyLog @relation(fields: [studyLogId], references: [id], onDelete: Cascade)
}

model StudyLogSkill {
  id         String @id @default(cuid())
  studyLogId String
  skillId    String
  xp         Int    @default(0)

  studyLog StudyLog @relation(fields: [studyLogId], references: [id], onDelete: Cascade)
  skill    Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([studyLogId, skillId])
}

model Goal {
  id              String   @id @default(cuid())
  userId          String
  title           String
  description     String?
  targetDate      DateTime?
  category        String?
  weeklyTargetMin Int?
  status          String   @default("active") // active | completed | abandoned
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmapItems RoadmapItem[]
  studyLinks   GoalStudyLog[]
}

model RoadmapItem {
  id            String   @id @default(cuid())
  goalId        String
  order         Int
  topic         String
  description   String?
  estimatedLogs Int      @default(2)
  isComplete    Boolean  @default(false)
  createdAt     DateTime @default(now())

  goal          Goal                   @relation(fields: [goalId], references: [id], onDelete: Cascade)
  studyLogLinks StudyLogRoadmapItem[]
}

model StudyLogRoadmapItem {
  id            String      @id @default(cuid())
  studyLogId    String
  roadmapItemId String
  studyLog      StudyLog    @relation(fields: [studyLogId], references: [id], onDelete: Cascade)
  roadmapItem   RoadmapItem @relation(fields: [roadmapItemId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([studyLogId, roadmapItemId])
}

model GoalStudyLog {
  id         String @id @default(cuid())
  goalId     String
  studyLogId String

  goal     Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  studyLog StudyLog @relation(fields: [studyLogId], references: [id], onDelete: Cascade)

  @@unique([goalId, studyLogId])
}

model Project {
  id                String   @id @default(cuid())
  userId            String
  title             String
  description       String?
  techStack         String?
  repoUrl           String?
  status            String   @default("in_progress")
  aiOverallFeedback String?
  notes             String?
  progressPct       Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  files   ProjectFile[]
  steps   ProjectStep[]
  updates ProjectUpdate[]
}

model ProjectFile {
  id            String  @id @default(cuid())
  projectId     String
  fileUrl       String
  fileType      String
  fileName      String
  filePath      String?
  extractedText String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectStep {
  id        String  @id @default(cuid())
  projectId String
  topic     String
  order     Int
  isComplete Boolean @default(false)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, topic])
}

model ProjectUpdate {
  id         String   @id @default(cuid())
  projectId  String
  content    String?
  aiComment  String?
  onTrack    Boolean?
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model Resume {
  id         String   @id @default(cuid())
  userId     String   @unique
  targetRole String
  content    String
  atsData    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MenteeProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  targetRole    String?
  timeline      String?
  skillLevel    String?
  learningStyle String?
  careerGoals   String?
  constraints   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyCheckin {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  studied   Boolean?
  skipped   Boolean?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model MentorConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages MentorMessage[]

  @@index([userId, updatedAt])
}

model MentorMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime @default(now())

  conversation MentorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}
